class_name Crest
extends Control
## Heraldic crest drawn in code (no assets): a party-per-pale shield in the club colours and a charge
## by emblem_key, taken from the canon description in QTTA c7 (silver arrow, scarlet bat, cannonball
## and double C, crossed bulrushes, hawk's head, golden talon, double K, magpie, golden star, double T,
## butcher's cleaver, striped wasp…). Filler clubs get generic charges or their initials.
## The real crests from the films and Pottermore belong to Warner: they are not copied.

var club: Club = null
var emblem_key: String = ""
var _tex: Texture2D = null
var _tex_key := ""


func _ready() -> void:
	if custom_minimum_size == Vector2.ZERO:
		custom_minimum_size = Vector2(40, 46)


func set_club(c: Club) -> void:
	club = c
	emblem_key = c.emblem_key if c != null else ""
	_tex = texture_for(c)
	_tex_key = _key(c) if c != null else ""
	queue_redraw()


static var _tex_cache: Dictionary = {}
static var _path_cache: Dictionary[String, String] = {}
static var _icon_cache: Dictionary = {}
const ICON_PX := 64


static func _key(c: Club) -> String:
	return "%s|%s|%s" % [c.id, str(c.colors.get("primary", "")), str(c.colors.get("secondary", ""))]


## Vector crest from assets/crests (generated by tools/make_crests.py); null if the club has none.
static func texture_for(c: Club) -> Texture2D:
	if c == null:
		return null
	var key := _key(c)
	if _tex_cache.has(key):
		var cached = _tex_cache[key]
		if not (cached is WeakRef):
			return cached
		var alive = (cached as WeakRef).get_ref()
		if alive != null:
			return alive
	var t: Texture2D = null
	if not _path_cache.has(c.id):
		_path_cache[c.id] = ""
		for path in ["res://assets/crests/ai/%s.png" % c.id, "res://assets/crests/%s.png" % c.id, "res://assets/crests/patched/%s.png" % c.id, "res://assets/crests/%s.svg" % c.id]:
			if ResourceLoader.exists(path):
				_path_cache[c.id] = path
				break
	var file: String = _path_cache[c.id]
	if file != "":
		t = load(file)
		_tex_cache[key] = weakref(t)
		return t
	if not c.id.begins_with("nt_"):
		t = _from_template(c)
	_tex_cache[key] = t
	return t


## The crest at list size (64 px), for Tree icons and small badges; null if the club has none. Keeps only the small
## copy, so the full-size texture can be freed once no screen shows it.
static func icon_for(c: Club) -> Texture2D:
	if c == null:
		return null
	var key := _key(c)
	if _icon_cache.has(key):
		return _icon_cache[key]
	var full := texture_for(c)
	var icon: Texture2D = full
	if full != null and maxi(full.get_width(), full.get_height()) > ICON_PX:
		# No image without a renderer (headless runs): the full texture then serves as is.
		var img := full.get_image()
		if img != null and not img.is_empty():
			if img.is_compressed():
				img.decompress()
			img.clear_mipmaps()
			var w := img.get_width()
			var h := img.get_height()
			var f := float(ICON_PX) / float(maxi(w, h))
			img.resize(maxi(1, int(round(w * f))), maxi(1, int(round(h * f))), Image.INTERPOLATE_CUBIC)
			img.generate_mipmaps()
			icon = ImageTexture.create_from_image(img)
	_icon_cache[key] = icon
	return icon


static var _templates: Dictionary = {}


static func _from_template(c: Club) -> Texture2D:
	if _templates.is_empty():
		var fa := FileAccess.open("res://data/shared/crest_templates.json", FileAccess.READ)
		if fa == null:
			return null
		_templates = JSON.parse_string(fa.get_as_text())
		if _templates == null:
			_templates = {}
			return null
	var tpls: Dictionary = _templates.get("templates", {})
	if tpls.is_empty():
		return null
	var keys := tpls.keys()
	keys.sort()
	var key := c.emblem_key if tpls.has(c.emblem_key) else str(keys[absi(hash(c.id)) % keys.size()])
	var tok: Dictionary = _templates["tokens"]
	var p := ThemeBuilder.hex(str(c.colors.get("primary", "#777777")))
	var sc := ThemeBuilder.hex(str(c.colors.get("secondary", "#dddddd")))
	var dp := p.darkened(float(_templates.get("dark_factor", 0.55)))
	var tl := sc if absf(sc.get_luminance() - p.get_luminance()) > 0.25 else (Color("#E8DDB5") if p.get_luminance() < 0.5 else Color("#2A2118"))
	var td := p.darkened(0.6) if p.get_luminance() >= 0.45 else tl.darkened(0.35)
	var svg := str(tpls[key]).replace(str(tok.get("tl", "#101112")), "#" + tl.to_html(false)).replace(str(tok.get("td", "#131415")), "#" + td.to_html(false))
	svg = svg.replace(str(tok["dp"]), "#" + dp.to_html(false)).replace(str(tok["p"]), "#" + p.to_html(false)).replace(str(tok["s"]), "#" + sc.to_html(false))
	var img := Image.new()
	if img.load_svg_from_string(mute_svg(svg), 2.0) != OK:
		return null
	var shape := str(_templates.get("template_shapes", {}).get(key, "shield"))
	if _fx.is_empty():
		_fx["twill"] = _load_image("res://assets/crests/fx/twill.png")
	if not _fx.has(shape):
		_fx[shape] = _load_image("res://assets/crests/fx/rim_%s.png" % shape)
	if _fx["twill"] != null and _fx[shape] != null:
		apply_patch(img, _fx["twill"], _fx[shape])
	return ImageTexture.create_from_image(img)


static var _fx: Dictionary = {}


static func _load_image(path: String) -> Image:
	if not ResourceLoader.exists(path):
		return null
	var tex: Texture2D = load(path)
	return tex.get_image() if tex != null else null


## Mutes the colours of an SVG (less saturated, a bit darker and warmer): the tone of dyed cloth.
static func mute_svg(svg: String) -> String:
	var re := RegEx.new()
	re.compile("#[0-9A-Fa-f]{6}")
	var out := ""
	var last := 0
	for m in re.search_all(svg):
		out += svg.substr(last, m.get_start() - last)
		var c := Color(m.get_string())
		var muted := Color.from_hsv(c.h, c.s * 0.7, c.v * 0.86 + 0.05).lerp(Color("#8C7A5E"), 0.1)
		out += "#" + muted.to_html(false)
		last = m.get_end()
	return out + svg.substr(last)


## Applies the weave (only inside the crest) and the embroidered border on top.
static func apply_patch(img: Image, twill: Image, rim: Image) -> void:
	if img.get_format() != Image.FORMAT_RGBA8:
		img.convert(Image.FORMAT_RGBA8)
	var r := Rect2i(Vector2i.ZERO, img.get_size())
	var tw := twill
	if tw.get_size() != img.get_size():
		tw = twill.duplicate()
		tw.resize(img.get_width(), img.get_height())
	var mask := img.duplicate()
	img.blend_rect_mask(tw, mask, r, Vector2i.ZERO)
	var rm := rim
	if rm.get_size() != img.get_size():
		rm = rim.duplicate()
		rm.resize(img.get_width(), img.get_height())
	if rm.get_format() != Image.FORMAT_RGBA8:
		rm = rm.duplicate()
		rm.convert(Image.FORMAT_RGBA8)
	img.blend_rect(rm, r, Vector2i.ZERO)


func _draw() -> void:
	if club == null:
		return
	var k := _key(club)
	if _tex == null or k != _tex_key:
		_tex = texture_for(club)
		_tex_key = k
	var tex := _tex
	if tex != null:
		var aspect := tex.get_width() / float(tex.get_height())
		var h := size.y
		var w := h * aspect
		if w > size.x:
			w = size.x
			h = w / aspect
		draw_texture_rect(tex, Rect2(Vector2((size.x - w) / 2.0, (size.y - h) / 2.0), Vector2(w, h)), false)
		return
	draw_crest(self, Rect2(Vector2.ZERO, size), club)


## Draws the crest on any CanvasItem (used by the 2D view and the profiles).
static func draw_crest(ci: CanvasItem, r: Rect2, c: Club) -> void:
	var pc := ThemeBuilder.hex(str(c.colors.get("primary", "#888888")))
	var sc := ThemeBuilder.hex(str(c.colors.get("secondary", "#dddddd")))
	var key := c.emblem_key
	var w := r.size.x
	var h := r.size.y
	var o := r.position
	var pts := PackedVector2Array([o + Vector2(0, 0), o + Vector2(w, 0), o + Vector2(w, h * 0.55), o + Vector2(w / 2.0, h), o + Vector2(0, h * 0.55)])
	ci.draw_colored_polygon(pts, pc)
	match key:
		"vertical_stripes_catapult":
			for i in 5:
				if i % 2 == 1:
					ci.draw_rect(Rect2(o.x + w * i / 5.0, o.y, w / 5.0, h * 0.55), sc)
			ci.draw_colored_polygon(PackedVector2Array([o + Vector2(w * 0.2, h * 0.55), o + Vector2(w * 0.4, h * 0.55), o + Vector2(w / 2.0, h * 0.8)]), sc)
			ci.draw_colored_polygon(PackedVector2Array([o + Vector2(w * 0.6, h * 0.55), o + Vector2(w * 0.8, h * 0.55), o + Vector2(w / 2.0, h * 0.8)]), sc)
		"horizontal_stripes_wasp":
			for i in 4:
				if i % 2 == 1:
					ci.draw_rect(Rect2(o.x, o.y + h * 0.55 * i / 4.0, w, h * 0.55 / 4.0), sc)
		_:
			ci.draw_rect(Rect2(o.x, o.y, w, h * 0.22), sc)
	var outline := pc.darkened(0.45)
	for i in pts.size():
		ci.draw_line(pts[i], pts[(i + 1) % pts.size()], outline, maxf(w * 0.05, 1.5))
	var cx := o.x + w / 2.0
	var cy := o.y + h * 0.58
	var s := w * 0.32
	var fig := sc if key != "vertical_stripes_catapult" and key != "horizontal_stripes_wasp" else pc.darkened(0.5)
	var light := Color("#F4EFE0")
	match key:
		"silver_arrow":
			ci.draw_line(Vector2(cx - s, cy + s), Vector2(cx + s, cy - s), Color("#C8CCD2"), w * 0.07)
			ci.draw_colored_polygon(PackedVector2Array([Vector2(cx + s, cy - s), Vector2(cx + s * 0.45, cy - s * 0.95), Vector2(cx + s * 0.95, cy - s * 0.45)]), Color("#C8CCD2"))
		"scarlet_bat":
			_bat(ci, Vector2(cx, cy), s, Color("#C8102E"))
		"cannonball_double_c":
			ci.draw_circle(Vector2(cx, cy + s * 0.15), s * 0.55, Color("#1B1B1B"))
			_text(ci, Vector2(cx, cy - s * 0.35), "CC", s * 0.9, light)
		"crossed_bulrushes":
			for sgn: float in [-1.0, 1.0]:
				ci.draw_line(Vector2(cx - sgn * s * 0.7, cy + s), Vector2(cx + sgn * s * 0.4, cy - s), Color("#D4AF37"), w * 0.05)
				ci.draw_rect(Rect2(cx + sgn * s * 0.4 - s * 0.12, cy - s * 1.05, s * 0.24, s * 0.5), Color("#6B4A1E"))
		"falcon_head":
			ci.draw_circle(Vector2(cx, cy), s * 0.6, light)
			ci.draw_colored_polygon(PackedVector2Array([Vector2(cx + s * 0.4, cy), Vector2(cx + s * 1.0, cy + s * 0.15), Vector2(cx + s * 0.45, cy + s * 0.35)]), Color("#D4AF37"))
			ci.draw_circle(Vector2(cx + s * 0.1, cy - s * 0.15), s * 0.1, Color("#1B1B1B"))
		"golden_talon":
			for i in 3:
				var a := -0.6 + i * 0.6
				var tip := Vector2(cx + sin(a) * s, cy + s * 0.9)
				ci.draw_line(Vector2(cx, cy - s * 0.6), tip, Color("#D4A017"), w * 0.06)
				ci.draw_circle(tip, w * 0.035, Color("#D4A017"))
		"double_k":
			_text(ci, Vector2(cx, cy), "KK", s * 1.0, Color("#F5D21F"))
		"double_t":
			_text(ci, Vector2(cx, cy), "TT", s * 1.0, light)
		"magpie":
			_bird(ci, Vector2(cx, cy), s, Color("#1B1B1B"), light)
		"golden_star", "star":
			_star(ci, Vector2(cx, cy), s * 0.9, Color("#D4AF37"))
		"meat_cleaver":
			ci.draw_rect(Rect2(cx - s * 0.7, cy - s * 0.5, s * 1.1, s * 0.75), Color("#C8CCD2"))
			ci.draw_rect(Rect2(cx + s * 0.4, cy - s * 0.3, s * 0.5, s * 0.22), Color("#6B4A1E"))
		"vulture", "harrier_hawk", "kite_bird", "finch", "macaw":
			_bird(ci, Vector2(cx, cy), s, fig, light)
		"hammer":
			ci.draw_rect(Rect2(cx - s * 0.1, cy - s * 0.3, s * 0.2, s * 1.2), Color("#6B4A1E"))
			ci.draw_rect(Rect2(cx - s * 0.7, cy - s * 0.8, s * 1.4, s * 0.5), Color("#C8CCD2"))
		"meteor", "bomb", "thunder", "storm", "sunray":
			ci.draw_circle(Vector2(cx, cy), s * 0.45, fig)
			for i in 8:
				var a := i * TAU / 8.0
				ci.draw_line(Vector2(cx, cy) + Vector2(cos(a), sin(a)) * s * 0.55, Vector2(cx, cy) + Vector2(cos(a), sin(a)) * s * 0.95, fig, w * 0.04)
		"tree":
			ci.draw_rect(Rect2(cx - s * 0.12, cy, s * 0.24, s * 0.9), Color("#6B4A1E"))
			ci.draw_circle(Vector2(cx, cy - s * 0.2), s * 0.6, Color("#3E7A3A"))
		"broom_fleet", "stick":
			ci.draw_line(Vector2(cx - s, cy + s * 0.6), Vector2(cx + s * 0.5, cy - s * 0.6), Color("#8B5A2B"), w * 0.06)
			for i in 5:
				ci.draw_line(Vector2(cx - s, cy + s * 0.6), Vector2(cx - s * 1.3 + i * s * 0.12, cy + s * 1.05), Color("#D4AF37"), w * 0.03)
		"fist_quaffle", "charm":
			ci.draw_circle(Vector2(cx, cy), s * 0.6, Color("#9B3B2E"))
			ci.draw_arc(Vector2(cx, cy), s * 0.6, 0, TAU, 24, light, w * 0.03)
		"gargoyle", "giant", "goblin", "warrior", "tengu":
			ci.draw_circle(Vector2(cx, cy - s * 0.2), s * 0.45, fig)
			ci.draw_rect(Rect2(cx - s * 0.6, cy + s * 0.25, s * 1.2, s * 0.7), fig)
		_:
			var initials := ""
			for part in c.short_name.split(" ", false):
				initials += part.left(1)
			_text(ci, Vector2(cx, cy), initials.left(2), s * 1.1, ThemeBuilder.text_on(pc))


static func _text(ci: CanvasItem, at: Vector2, txt: String, px: float, color: Color) -> void:
	var f := ThemeBuilder.font("title")
	var size := int(maxf(px, 6.0))
	var ts := f.get_string_size(txt, HORIZONTAL_ALIGNMENT_CENTER, -1, size)
	ci.draw_string(f, at + Vector2(-ts.x / 2.0, ts.y * 0.35), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, size, color)


static func _star(ci: CanvasItem, at: Vector2, rad: float, color: Color) -> void:
	var pts := PackedVector2Array()
	for i in 10:
		var a := -PI / 2.0 + i * PI / 5.0
		var rr := rad if i % 2 == 0 else rad * 0.45
		pts.append(at + Vector2(cos(a), sin(a)) * rr)
	ci.draw_colored_polygon(pts, color)


static func _bat(ci: CanvasItem, at: Vector2, s: float, color: Color) -> void:
	ci.draw_circle(at, s * 0.22, color)
	for sgn: float in [-1.0, 1.0]:
		var wing := PackedVector2Array([at, at + Vector2(sgn * s * 0.35, -s * 0.5), at + Vector2(sgn * s * 1.0, -s * 0.3), at + Vector2(sgn * s * 0.8, s * 0.1), at + Vector2(sgn * s * 0.95, s * 0.5), at + Vector2(sgn * s * 0.45, s * 0.35), at + Vector2(sgn * s * 0.25, s * 0.6)])
		ci.draw_colored_polygon(wing, color)


static func _bird(ci: CanvasItem, at: Vector2, s: float, body: Color, light: Color) -> void:
	ci.draw_circle(at + Vector2(0, s * 0.1), s * 0.45, body)
	ci.draw_circle(at + Vector2(s * 0.35, -s * 0.35), s * 0.25, body)
	ci.draw_colored_polygon(PackedVector2Array([at + Vector2(s * 0.55, -s * 0.35), at + Vector2(s * 0.95, -s * 0.28), at + Vector2(s * 0.55, -s * 0.2)]), Color("#D4A017"))
	ci.draw_colored_polygon(PackedVector2Array([at + Vector2(-s * 0.2, 0), at + Vector2(-s * 1.0, -s * 0.5), at + Vector2(-s * 0.6, s * 0.2)]), body.lightened(0.2) if body.get_luminance() < 0.5 else body.darkened(0.2))
	ci.draw_circle(at + Vector2(s * 0.42, -s * 0.4), s * 0.06, light)
