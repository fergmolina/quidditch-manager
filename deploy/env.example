# Environment for the production Compose project (/srv/quidditch-manager/.env, mode 600, owned by the deploy user).
# NAMES ONLY: this file is public. Real values live only on the server, never in the repository, CI or images.
# deploy/bootstrap.sh copies this file to .env and fills POSTGRES_PASSWORD, DB_API_PASSWORD and AUTH_SECRET with
# random hex when they are empty. Plain KEY=value lines only (compose and the deploy scripts both read this file).
# Every container gets only the variables listed for it in deploy/compose.yml: a new variable the api needs must be
# added there too.

# --- Site ---------------------------------------------------------------------------------------------------------
# https://<domain> with no trailing slash. The only origin accepted on POSTs; used for magic links and redirects.
SITE_URL=
NODE_ENV=production
# Optional: link to the desktop downloads shown on the landing page (e.g. the GitHub Releases page).
DOWNLOADS_URL=

# --- Database -----------------------------------------------------------------------------------------------------
# Secret. `openssl rand -hex 24` (hex: it goes into a URL).
POSTGRES_PASSWORD=
# Secret. Least-privilege login used by the API (role qm_api, created by server/migrations/0003_roles.sql without a
# password; deploy/postgres/init/10-schema.sh and deploy/db/apply.sh set it from DB_API_PASSWORD). Hex only.
DB_API_USER=qm_api
DB_API_PASSWORD=
# The API reads DATABASE_URL; compose builds it as postgres://${DB_API_USER}:${DB_API_PASSWORD}@db:5432/${POSTGRES_DB:-qm}.
# Leave it unset unless you really need to override that.
# DATABASE_URL=
DB_POOL_MAX=5
# 1 (default): a fresh database volume gets every migration on first boot. 0: leave it empty for a restore.
QM_INIT_SCHEMA=1

# --- Login --------------------------------------------------------------------------------------------------------
# Google OAuth (Web client). Redirect URI: ${SITE_URL}/auth/google/callback. Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# Secret. Resend API key for the magic-link emails. Required in production unless LOGIN_EMAIL=off.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Quidditch Manager <login@<domain>>".
MAIL_FROM=
# on | off
LOGIN_EMAIL=on
# Global cap of magic-link emails per rolling 24 h (protects the Resend free quota). 0 = no cap.
MAIL_DAILY_CAP=90
# Secret, optional, at least 32 characters (`openssl rand -hex 32`). Keys the OAuth state cookie signature and the
# hashed IP buckets. When unset, a random key is generated per process (a restart then only breaks in-flight Google
# logins and resets per-IP counters).
AUTH_SECRET=
# Version of the terms/privacy policy users must accept (bump to make everyone accept again).
TERMS_VERSION=
# Optional: the address that receives a copy of the bug reports and ideas sent from /feedback (they are stored in
# the database either way). Sent through Resend like the magic links, so it needs email on. Never committed.
FEEDBACK_TO=
# Data controller shown on /privacy and /terms (server/legal/*.md): the name of the person or organisation running
# the site, and a contact address on the game's domain. Kept out of the public repository on purpose. Until both are
# set, the pages show "[Operator name]" / "[contact email on the game's domain]" and the API logs a warning.
LEGAL_CONTROLLER=
LEGAL_CONTACT_EMAIL=
# Per-user requests per minute on /api/* (in-process burst cap). 0 disables.
SESSION_RATE_PER_MINUTE=60
# Request header the api trusts for the visitor's IP (rate limits, hashed). Only Cloudflare can reach the api in the
# default topology, so its header is safe; change it only with another edge in front.
TRUSTED_PROXY_HEADER=cf-connecting-ip
# Days a deleted account can still exist in a backup, as promised on /account/delete. Must cover BACKUP_KEEP_* below.
BACKUP_RETENTION_DAYS=45

# --- Edge (Cloudflare) -------------------------------------------------------------------------------------------
# Secret. Token of the Cloudflare Tunnel (Zero Trust → Networks → Tunnels → <tunnel> → install connector). The
# tunnel's public hostname points at http://caddy:8080. While empty, cloudflared does not start (local-only stack).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Releases (deploy/update.sh) ---------------------------------------------------------------------------------
# GitHub repository that publishes the releases, as owner/name (public: no credentials are used).
RELEASE_REPO=
# Name of the web export archive attached to each GitHub Release ({version} = the tag, e.g. v0.11.0), listed with
# its SHA-256 in the release's SHA256SUMS file. .zip, .tar.gz or .tgz.
WEB_ASSET=QuidditchManager-{version}-web.zip
# Container image of the api WITHOUT a tag, e.g. ghcr.io/<owner>/quidditch-manager-api (public package); update.sh
# pulls <API_IMAGE>:<version>. Empty: update.sh builds the image on the server from the release tag instead.
API_IMAGE=
# How many web releases to keep on disk besides the current and the previous one.
KEEP_RELEASES=3

# --- Host layout -------------------------------------------------------------------------------------------------
# Runtime data outside the git checkout: web/ (releases + current symlink), backups/, state/.
QM_DATA_DIR=/srv/quidditch-manager-data
# Owner of QM_DATA_DIR/backups (the backup container runs as this user). bootstrap.sh writes the deploy user's ids.
QM_UID=1000
QM_GID=1000
# Caddy's port on 127.0.0.1 of the host (health probe and smoke tests over SSH). Never public.
QM_HTTP_PORT=8080

# --- Backups (Backblaze B2, EU Central region, private bucket) -----------------------------------------------------
# Application key limited to the one bucket (read + write). Secret: B2_APP_KEY.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Folder inside the bucket.
B2_PATH=qm
# Secret, optional. When set, the offsite copies are encrypted client-side (rclone crypt); keep it in a password
# manager too: without it the offsite copies cannot be read. `openssl rand -hex 32`.
BACKUP_CRYPT_PASSWORD=
# Retention (7 daily + 4 weekly). Defaults live in deploy/compose.yml; the privacy policy's backup window depends
# on them. Only set these if you also update the privacy policy.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4

# --- Alerts (optional) --------------------------------------------------------------------------------------------
# Secret. Telegram bot for backup failures and the health probe (deploy/healthcheck.sh).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
