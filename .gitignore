# Godot
.godot/
export/
# Generated by the import step (`godot --headless --path . --import`, see README): the compiled translations
# (locale/strings.*.translation) and the import metadata of tool-only files (map SVG intermediates). locale/tr/ holds
# translator CSVs that Godot must not import (locale/tr/.gdignore); importing them crashed the CI importer once.
*.translation
tools/map_data/*.import

# Python
__pycache__/
*.py[cod]
.venv/

# Secrets and the web accounts service (docs/design/12)
.env
.env.*
!.env.example
server/node_modules/
server/dist/

# OS and local tooling
.DS_Store
# Agent state stays local. Only the project's own skills are part of the repo (synced personal skills are symlinks).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/verify-quidditch-manager/
!.claude/skills/formal-match-day/
.agents/
skills-lock.json

# Official third-party crests (Emily Gravett's patches for the illustrated QTTA, Pottermore house crests).
# Not part of the project; the game uses the AI versions in assets/crests/ai/. Kept outside the repo.
assets/crests/club_*.png
assets/crests/club_*.png.import
assets/crests/hs_*.png
assets/crests/hs_*.png.import

# Private keys and local credentials
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ecdsa
id_ed25519
.ssh/

# Saves, database state and backups
*.qmsave
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.dump
*.sql.gz
*.sql.zst
/backups/
/dumps/
/saves/
# Verification runs (qm-verify): isolated HOMEs and proof artifacts, never committed.
.verify/

# Logs can contain development magic links and email addresses
*.log

# Local editor / agent state
.idea/
.vscode/
.codex/
*.code-workspace
*.swp
*.swo
/override.cfg

# Additional build output locations
/build/
/dist/
*.pck
*.dmg
